---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
---

<Layout title="About - Tailspin Toys">
  <section class="relative py-16">
    <!-- Background effects -->
    <div class="absolute inset-0">
      <div class="absolute top-20 left-20 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl animate-pulse"></div>
      <div class="absolute bottom-20 right-20 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
    </div>
    
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Enhanced about content -->
      <div class="bg-slate-800/60 backdrop-blur-sm border border-slate-700/50 rounded-3xl shadow-2xl p-8 lg:p-12 transition-colors duration-300">
        <!-- Header with gradient accent -->
        <div class="text-center mb-12">
          <h2 class="text-5xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-blue-400 via-purple-400 to-cyan-400 bg-clip-text text-transparent leading-tight">
            About Tailspin Toys
          </h2>
          <div class="w-32 h-1 bg-gradient-to-r from-blue-500 via-purple-500 to-cyan-500 mx-auto rounded-full"></div>
        </div>
        
        <!-- Enhanced content grid -->
        <div class="grid lg:grid-cols-2 gap-12 items-center mb-16">
          <!-- Left column - main content -->
          <div class="space-y-8">
            <div class="relative">
              <div class="absolute -left-4 top-0 w-1 h-full bg-gradient-to-b from-blue-500 to-purple-500 rounded-full"></div>
              <p class="text-lg leading-relaxed text-slate-300 pl-8">
                Tailspin Toys is the premier crowdfunding platform dedicated to bringing board games with a development and DevOps twist to life. We believe that the same collaborative spirit, iteration cycles, and problem-solving that power modern software teams can make for endlessly engaging tabletop experiences.
              </p>
            </div>
            
            <div class="relative">
              <div class="absolute -left-4 top-0 w-1 h-full bg-gradient-to-b from-purple-500 to-cyan-500 rounded-full"></div>
              <p class="text-lg leading-relaxed text-slate-300 pl-8">
                By focusing exclusively on games that explore themes like continuous integration, agile planning, container orchestration, and incident response, we offer a unique space where both seasoned developers and curious newcomers can back - and even contribute to - the games they're most passionate about.
              </p>
            </div>
          </div>
          
          <!-- Right column - features -->
          <div class="space-y-6">
            <div class="group p-6 bg-gradient-to-br from-blue-900/30 to-blue-800/20 rounded-2xl border border-blue-700/30 hover:border-blue-500/50 transition-all duration-300">
              <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center mr-4 group-hover:scale-110 transition-transform duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-white">Innovation Focus</h3>
              </div>
              <p class="text-slate-400">Cutting-edge game mechanics inspired by real DevOps practices</p>
            </div>
            
            <div class="group p-6 bg-gradient-to-br from-purple-900/30 to-purple-800/20 rounded-2xl border border-purple-700/30 hover:border-purple-500/50 transition-all duration-300">
              <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center mr-4 group-hover:scale-110 transition-transform duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-white">Community Driven</h3>
              </div>
              <p class="text-slate-400">Collaborative development with backer feedback and iterations</p>
            </div>
            
            <div class="group p-6 bg-gradient-to-br from-cyan-900/30 to-cyan-800/20 rounded-2xl border border-cyan-700/30 hover:border-cyan-500/50 transition-all duration-300">
              <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-gradient-to-br from-cyan-500 to-cyan-600 rounded-xl flex items-center justify-center mr-4 group-hover:scale-110 transition-transform duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-white">Quality Assured</h3>
              </div>
              <p class="text-slate-400">Rigorous testing and quality control for every release</p>
            </div>
          </div>
        </div>
        
        <!-- Mission statement -->
        <div class="relative mb-16">
          <div class="text-center p-8 bg-gradient-to-r from-slate-800/40 to-slate-700/40 rounded-3xl border border-slate-600/50">
            <h3 class="text-2xl font-bold text-white mb-6">Our Mission</h3>
            <p class="text-lg leading-relaxed text-slate-300 max-w-4xl mx-auto">
              The name "Tailspin Toys" reflects our love of both flight metaphors and that moment when a project takes on a life of its own - spinning through sprints, releases, and hotfixes until it soars. Founded by a team of developers who were always gamers at heart, we know firsthand how satisfying it is to conquer a tricky bug or pull off a flawless deployment.
            </p>
          </div>
        </div>
        
        <!-- Platform features -->
        <div class="mb-16">
          <h3 class="text-3xl font-bold text-center mb-12 bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">
            Platform Features
          </h3>
          
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="group p-6 bg-slate-800/40 backdrop-blur-sm rounded-2xl border border-slate-700/50 hover:border-blue-500/50 transition-all duration-300 hover:transform hover:scale-105">
              <div class="text-center">
                <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:shadow-lg group-hover:shadow-blue-500/25 transition-all duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                  </svg>
                </div>
                <h4 class="text-xl font-semibold text-white mb-3">Community Feedback</h4>
                <p class="text-slate-400">Share house rules, vote on art directions, and influence game development</p>
              </div>
            </div>
            
            <div class="group p-6 bg-slate-800/40 backdrop-blur-sm rounded-2xl border border-slate-700/50 hover:border-purple-500/50 transition-all duration-300 hover:transform hover:scale-105">
              <div class="text-center">
                <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:shadow-lg group-hover:shadow-purple-500/25 transition-all duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                </div>
                <h4 class="text-xl font-semibold text-white mb-3">Beta Testing</h4>
                <p class="text-slate-400">Early access to prototypes and exclusive beta-play sessions</p>
              </div>
            </div>
            
            <div class="group p-6 bg-slate-800/40 backdrop-blur-sm rounded-2xl border border-slate-700/50 hover:border-cyan-500/50 transition-all duration-300 hover:transform hover:scale-105">
              <div class="text-center">
                <div class="w-16 h-16 bg-gradient-to-br from-cyan-500 to-cyan-600 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:shadow-lg group-hover:shadow-cyan-500/25 transition-all duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                  </svg>
                </div>
                <h4 class="text-xl font-semibold text-white mb-3">Logistics Handled</h4>
                <p class="text-slate-400">Complete manufacturing and fulfillment management</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Call to action -->
        <div class="text-center">
          <p class="text-xl text-slate-300 mb-8">
            Whether you're here to back your next favorite game or to launch your own DevOps-inspired design, 
            <span class="text-blue-400 font-semibold">welcome aboard</span>. Let's game from here, together!
          </p>
          
          <a href="/" class="group inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-semibold rounded-2xl transition-all duration-300 transform hover:scale-105 hover:shadow-xl hover:shadow-blue-500/25">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 transform transition-transform duration-300 group-hover:-translate-x-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
            </svg>
            Back to Games
            <div class="absolute inset-0 bg-gradient-to-r from-blue-400 to-purple-400 rounded-2xl blur opacity-0 group-hover:opacity-20 transition-opacity duration-300"></div>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>